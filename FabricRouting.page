<?php
/**
 * Settings → Network Settings → Fabric Routing
 * CA: Fabric Routing (FRR). Plugin id: FabricRouting.
 *
 * Tab order: Unraid PageBuilder key is "{rank}{pageName}" with SORT_NATURAL.
 * Numeric ranks (eth :100, Wireless :1000, Thunderbolt :1100, tbn :1110+) sort
 * *before* unranked stock tabs (Interface Extra/Rules, Routing Table).
 * Rank "z" → key "zFabricRouting" sorts *after* RoutingTable (far right).
 * Rank "1200" wrongly sat between tbn and Interface Extra — next to Thunderbolt.
 */
require_once '/usr/local/emhttp/plugins/FabricRouting/include/frr-lib.php';

$plugin = 'FabricRouting';
$cfg = function_exists('parse_plugin_cfg') ? parse_plugin_cfg($plugin) : [];
if (!is_array($cfg)) {
  $cfg = [];
}
$cfg = array_merge(frr_load_cfg(), $cfg);
$st = frr_status();
$det = $st['detect'];
$bundle = $st['bundle'] ?? [];
$ver = htmlspecialchars($st['plugin_version'] ?? 'dev');
$tbn = !empty($st['thunderboltnet_present']);
$uver = htmlspecialchars($det['unraid_version'] ?? frr_unraid_version());
$arch = htmlspecialchars($det['arch'] ?? frr_arch());

$zebra_run = !empty($det['running_zebra']);
$fabricd_run = !empty($det['running_fabricd']);
$frr_ok = !empty($det['vtysh']) || $zebra_run || $fabricd_run;
$pk = $det['packages_on_flash'] ?? [];
$bundle_ok = !empty($bundle['ok']);
?>
