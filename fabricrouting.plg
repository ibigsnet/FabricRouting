<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "FabricRouting">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.09.08aa">
<!ENTITY launch "Settings/FabricRouting">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/FabricRouting/testing/fabricrouting.plg">
<!ENTITY github "ibigsnet/FabricRouting">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/FabricRouting/testing">
<!ENTITY plugdir "/usr/local/emhttp/plugins/FabricRouting">
<!ENTITY configdir "/boot/config/plugins/FabricRouting">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="share-alt"
  min="6.12.0"
  support="https://forums.unraid.net/topic/200065-plugin-thunderbolt-net-host-to-host-networking-over-thunderbolt-345-and-usb44v2/"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/testing/README.md">

<CHANGES>
###&version;
- Install overlays hashed files; do not wipe the live plugin before FILE copy.

###2026.09.06aa–ab
- Hashed raw plugin install (SHA256/MD5); catalog/install URLs pin main.

###2026.08.28aa
- Download and Install: Done/Dismiss after packages finish.

###2026.08.17af–ac
- Package download streams to disk; openBox progress; README/icon.

###2026.08.17ad
- Support: Thunderbolt Net forum thread.

###2026.08.17aa
- No dynamix/network.cfg patch; array-start rehydrate local-only.

###2026.08.16aa
- Clean plugin-package replace on upgrade (not FRR flash cache).

### Older releases
- Full changelog: https://github.com/ibigsnet/FabricRouting/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "FabricRouting: preparing..."
# Note: do not delete /tmp/plugins/fabricrouting.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/FabricRouting/packages
# Forget old plugin-shell txz registration WITHOUT deleting the live tree.
# Never removepkg frr / libyang from packages/.
for p in /var/log/packages/FabricRouting-* /var/log/packages/UnraidFRR-*; do
  [ -e "$p" ] || continue
  echo "FabricRouting: forgetting old plugin package $(basename "$p") (overlay files next)"
  rm -f "$p"
done
rm -rf /usr/local/emhttp/plugins/UnraidFRR \
       /usr/local/emhttp/plugins/fabricrouting 2>/dev/null || true
rm -f /boot/config/plugins/FabricRouting/FabricRouting-*.txz 2>/dev/null || true
mkdir -p /usr/local/emhttp/plugins/FabricRouting/{include,scripts,event,packages}
echo "FabricRouting: ready."
]]></INLINE>
</FILE>

