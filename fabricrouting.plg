<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "FabricRouting">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.10.30ab">
<!ENTITY launch "Settings/FabricRouting">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/FabricRouting/testing/fabricrouting.plg">
<!ENTITY github "ibigsnet/FabricRouting">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/FabricRouting/testing">
<!ENTITY plugdir "/usr/local/emhttp/plugins/FabricRouting">
<!ENTITY configdir "/boot/config/plugins/FabricRouting">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="share-alt"
  min="7.0.0"
  support="https://forums.unraid.net/topic/200065-plugin-thunderbolt-net-host-to-host-networking-over-thunderbolt-345-and-usb44v2/"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/testing/README.md">

<CHANGES>
###&version;
- Packages are sha256-checked before every install; a failed download or bad hash stops the job. FRR restarts when its config or packages change. No PHP 8.4 deprecation notices.
- Fabric Routing now builds /etc/frr from flash (Thunderbolt Net fragment, frr.user.conf, new route guard). Uninstall removes only what it installed. Needs Unraid 7.0+.

###2026.10.01aa
- Plugins page description is the short summary.
- Settings opens on the FRR notes.

###2026.09.28ab
- Settings save include refuses GET (only runs from Unraid update.php POST).

###2026.09.28aa
- Package catalog is the manifest.json bundled with the plugin; no lookup on live main. Install drops old .txz by version.

###2026.09.27aa
- Plugin payload is a flash .txz from the GitHub Release (not re-fetched from main at boot).

###2026.09.08aa
- Install overlays hashed files; do not wipe the live plugin before FILE copy.

###2026.09.06aa–ab
- Hashed plugin install (SHA256/MD5); catalog/install URLs pin main.

### Older releases
- Full changelog: https://github.com/ibigsnet/FabricRouting/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "FabricRouting: preparing..."
# Note: do not delete /tmp/plugins/fabricrouting.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/FabricRouting/packages
# Never removepkg frr / libyang from packages/.
rm -rf /usr/local/emhttp/plugins/UnraidFRR \
       /usr/local/emhttp/plugins/fabricrouting 2>/dev/null || true
# Flash files older versions wrote (lock and log now live in RAM; catalog is bundled).
rm -f /boot/config/plugins/FabricRouting/apply.lock \
      /boot/config/plugins/FabricRouting/fabricrouting.log \
      /boot/config/plugins/FabricRouting/manifest.cache.json 2>/dev/null || true
echo "FabricRouting: ready."
]]></INLINE>
</FILE>

<!-- raw-files begin -->
<FILE Name="&configdir;/FabricRouting-&version;-x86_64-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/ibigsnet/FabricRouting/releases/download/v&version;/FabricRouting-&version;-x86_64-1.txz</URL>
<SHA256>52db20ab6bdeaf2abba050148e5e2f186a1056ede81e968d398b89f90c915f31</SHA256>
<MD5>488990d40da10714f0c6d8acc01e97c3</MD5>
</FILE>
<!-- raw-files end -->

<FILE Run="/bin/bash">
<INLINE>find &configdir; -maxdepth 1 -name "&name;-*-x86_64-1.txz" ! -name "&name;-&version;-x86_64-1.txz" -delete 2>/dev/null || true</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "FabricRouting: finishing install..."
if [ ! -f /usr/local/emhttp/plugins/FabricRouting/include/frr-lib.php ] \
   && [ ! -f /usr/local/emhttp/plugins/FabricRouting/FabricRouting.page ]; then
  echo "FabricRouting: ERROR — package did not install (missing plugin files)"
  exit 1
fi
chmod 755 /usr/local/emhttp/plugins/FabricRouting/scripts/* 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/FabricRouting/event/started 2>/dev/null || true
mkdir -p /boot/config/plugins/FabricRouting/packages
if [ ! -f /boot/config/plugins/FabricRouting/FabricRouting.cfg ] \
   && [ -f /usr/local/emhttp/plugins/FabricRouting/default.cfg ]; then
  cp -a /usr/local/emhttp/plugins/FabricRouting/default.cfg /boot/config/plugins/FabricRouting/FabricRouting.cfg
fi
# Legacy UnraidFRR flash (one-time migrate)
if [ -d /boot/config/plugins/UnraidFRR ]; then
  cp -an /boot/config/plugins/UnraidFRR/. /boot/config/plugins/FabricRouting/ 2>/dev/null || true
fi
# Upgrade on a running system: hand /etc/frr to the new config builder now (detached).
if [ -s /var/run/frr/zebra.pid ]; then
  nohup /usr/local/emhttp/plugins/FabricRouting/scripts/frr-reload >/dev/null 2>&1 </dev/null &
  echo "FabricRouting: FRR is running; rebuilding /etc/frr in the background."
fi
echo "FabricRouting: packages now: $(ls /var/log/packages/FabricRouting-* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
echo "FabricRouting: install complete. Settings → Network Settings → Fabric Routing"
echo "FabricRouting: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
S=/usr/local/emhttp/plugins/FabricRouting/scripts/frr-uninstall
if [ -f "$S" ]; then
  bash "$S" --all
else
  echo "FabricRouting: uninstall script missing; removing plugin files only."
  rm -rf /usr/local/emhttp/plugins/FabricRouting /boot/config/plugins/FabricRouting
  rm -f /var/log/fabricrouting.log /run/fabricrouting.lock
fi
# Note: do not delete /tmp/plugins/fabricrouting.plg here — Unraid install working copy
echo "FabricRouting: did not modify network.cfg, br0, Docker, or Thunderbolt Net."
echo "FabricRouting: hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

</PLUGIN>
