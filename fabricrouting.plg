<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "FabricRouting">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.08.17ac">
<!ENTITY launch "Settings/FabricRouting">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/FabricRouting/main/fabricrouting.plg">
<!ENTITY github "ibigsnet/FabricRouting">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/FabricRouting/main">
<!ENTITY plugdir "/usr/local/emhttp/plugins/FabricRouting">
<!ENTITY configdir "/boot/config/plugins/FabricRouting">
<!ENTITY pkg "FabricRouting-&version;-x86_64-1">
<!ENTITY pkgfile "&pkg;.txz">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="project-diagram"
  min="6.12.0"
  support="https://github.com/&github;/issues"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/main/README.md">

<CHANGES>
###&version;
- Fix Download &amp; Install packages: use openBox progress window (openPlugin could return pid=0 with no UI).

###2026.08.17ab
- Plugins UI: trim embedded CHANGES list.

###2026.08.17aa
- Docs/audit: no dynamix/network.cfg patch; array-start rehydrate local-only.

###2026.08.16aa
- Clean package replace on upgrade (plugin package only; not FRR flash cache).

###2026.08.15af
- Full uninstall wipe; clear leftover FRR runtime dirs.

###2026.08.15ae
- Do not wipe Unraid /tmp/plugins working copy during install prepare.

###2026.08.14ak
- Package job: no hang on FRR start; openBox reaches DONE.

### Older releases
- Full changelog: https://github.com/ibigsnet/FabricRouting/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "FabricRouting: preparing..."
# Note: do not delete /tmp/plugins/fabricrouting.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/FabricRouting/packages
# Plugin packages only (YYYY.MM.DDxx) — never removepkg frr / libyang from packages/
for p in /var/log/packages/FabricRouting-* /var/log/packages/UnraidFRR-*; do
  [ -e "$p" ] || continue
  echo "FabricRouting: removing old plugin package $(basename "$p")"
  removepkg "$(basename "$p")" 2>/dev/null || true
done
rm -rf /usr/local/emhttp/plugins/FabricRouting \
       /usr/local/emhttp/plugins/UnraidFRR \
       /usr/local/emhttp/plugins/fabricrouting 2>/dev/null || true
# Cached plugin runtime .txz only — keep packages/ FRR .txz flash cache
rm -f /boot/config/plugins/FabricRouting/FabricRouting-*.txz 2>/dev/null || true
echo "FabricRouting: ready."
]]></INLINE>
</FILE>

<FILE Name="/boot/config/plugins/FabricRouting/&pkgfile;" Run="upgradepkg --install-new --reinstall">
<URL>&raw;/archive/&pkgfile;?v=&version;</URL>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "FabricRouting: finishing install..."
if [ ! -f /usr/local/emhttp/plugins/FabricRouting/include/frr-lib.php ] \
   && [ ! -f /usr/local/emhttp/plugins/FabricRouting/FabricRouting.page ]; then
  echo "FabricRouting: ERROR — package did not install (missing plugin files)"
  exit 1
fi
chmod 755 /usr/local/emhttp/plugins/FabricRouting/scripts/* 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/FabricRouting/event/started 2>/dev/null || true
mkdir -p /boot/config/plugins/FabricRouting/packages
if [ ! -f /boot/config/plugins/FabricRouting/FabricRouting.cfg ] \
   && [ -f /usr/local/emhttp/plugins/FabricRouting/default.cfg ]; then
  cp -a /usr/local/emhttp/plugins/FabricRouting/default.cfg /boot/config/plugins/FabricRouting/FabricRouting.cfg
fi
# Legacy UnraidFRR flash (one-time migrate)
if [ -d /boot/config/plugins/UnraidFRR ]; then
  cp -an /boot/config/plugins/UnraidFRR/. /boot/config/plugins/FabricRouting/ 2>/dev/null || true
fi
echo "FabricRouting: packages now: $(ls /var/log/packages/FabricRouting-* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
echo "FabricRouting: install complete. Settings → Network Settings → Fabric Routing"
echo "FabricRouting: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "FabricRouting: removing..."
# Stop in-flight jobs / daemons
rm -f /boot/config/plugins/FabricRouting/apply.lock 2>/dev/null || true
pkill -f 'frr_apply|FabricRouting/include/frr-lib' 2>/dev/null || true
systemctl stop frr 2>/dev/null || true
/usr/sbin/frrinit.sh stop 2>/dev/null || true
/usr/lib/frr/frrinit.sh stop 2>/dev/null || true
service frr stop 2>/dev/null || true
for p in zebra fabricd bgpd ospfd ospf6d isisd staticd bfdd watchfrr mgmtd; do
  pkill -x "$p" 2>/dev/null || true
done
sleep 1
for p in zebra fabricd bgpd ospfd ospf6d isisd staticd bfdd watchfrr mgmtd; do
  pkill -9 -x "$p" 2>/dev/null || true
done
# FRR packages this plugin installed (manifest + sweep)
MAN=/boot/config/plugins/FabricRouting/packages/MANIFEST.txt
if [ -f "$MAN" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="$(echo "$line" | tr -d '\r' | xargs)"
    [ -z "$line" ] && continue
    base="$(basename "$line")"
    pkgname="$(echo "$base" | sed -E 's/\.(t[gx]z|tar\.gz)$//')"
    removepkg "$pkgname" 2>/dev/null || true
  done < "$MAN"
fi
for pkgpath in /var/log/packages/frr-* /var/log/packages/libyang-*; do
  [ -e "$pkgpath" ] || continue
  removepkg "$(basename "$pkgpath")" 2>/dev/null || true
done
# Plugin package + emhttp
for p in /var/log/packages/FabricRouting-*; do
  [ -e "$p" ] || continue
  removepkg "$(basename "$p")" 2>/dev/null || true
done
rm -rf /var/run/frr /run/frr /etc/frr /var/lib/frr /var/tmp/frr 2>/dev/null || true
rm -f /var/log/fabricrouting.log 2>/dev/null || true
rm -rf /usr/local/emhttp/plugins/FabricRouting
# Legacy product id
rm -rf /usr/local/emhttp/plugins/UnraidFRR /boot/config/plugins/UnraidFRR
rm -f /boot/config/plugins/unraidfrr.plg /var/log/plugins/unraidfrr.plg 2>/dev/null || true
# Flash plugin tree (includes package cache)
rm -rf /boot/config/plugins/FabricRouting
rm -f /var/log/plugins/fabricrouting.plg 2>/dev/null || true
rm -f /tmp/plugins/fabricrouting.txt 2>/dev/null || true
# Note: do not delete /tmp/plugins/fabricrouting.plg here — Unraid install working copy
# Note: do not touch /boot/config/plugins-removed/ (Unraid-owned)
echo "FabricRouting: removed."
echo "FabricRouting: did not modify network.cfg, br0, Docker, or Thunderbolt Net."
echo "FabricRouting: hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

</PLUGIN>
