<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "UnraidFRR">
<!ENTITY author "RifleJock">
<!--
  Versioning — Unraid plugin updates use strcmp() (lexicographic).
  YYYY.MM.DD then aa, ab, … same day. No hyphens.
  Same rules as StorageGuard / ThunderboltNet.
-->
<!ENTITY version "2026.08.11af">
<!ENTITY launch "Settings/UnraidFRR">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/UnraidFRR/main/unraidfrr.plg">
<!ENTITY github "ibigsnet/UnraidFRR">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/UnraidFRR/main">
<!ENTITY plugdir "/usr/local/emhttp/plugins/UnraidFRR">
<!ENTITY configdir "/boot/config/plugins/UnraidFRR">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="project-diagram"
  min="6.12.0"
  support="https://github.com/&github;/issues"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/main/README.md">

<CHANGES>
###&version;
- Fix Settings placement: **System Settings tile** (`Menu="OtherSettings"`), not embedded section on /Settings (`Settings:50` was wrong).
- Uninstall: also remove any stray UnraidFRR/FRR .page copies under webGui/dynamix; clear /tmp plugin remnants.

###2026.08.11ae
- Docs/UI: when to install (rings, multi-hop, Proxmox+Unraid) vs skip (single static TB cable); roles vs Thunderbolt Net OpenFabric policy.

###2026.08.11ad
- UI: status labels distinguish plugin version / Unraid product / FRR package set; USB4STREAM is kernel (not Unraid 7.2 product); companion strip wording.
- Catalog matching uses Unraid product version + arch only (not uname -r).

###2026.08.11ac
- Docs: DOCS/RELEASES/docs index aligned with Storage Guard + Thunderbolt Net (CA + raw install, uninstall).
- Uninstall: stop FRR, removepkg managed packages, clear emhttp + flash config — no leftover hooks; does not touch network.cfg or Thunderbolt Net.
- Install finish message: automated Apply path (no manual package drop).

###2026.08.11ab
- Fully automated packages (Nvidia-plugin style): catalog manifest, auto-download + sha256, installpkg, array-start rehydrate — no manual package drops.
- UI: package channel, auto-download default Yes; status shows Unraid version/arch/bundle match.
- Docs: automation-design.md; DOCS/README updated for full control by the plugin.

###2026.08.11aa
- README: short Unraid Plugins-list blurb (same format as Storage Guard / Thunderbolt Net); long docs stay in DOCS.md.

###2026.08.11
- Initial public release: standalone FRR package install hooks, daemon toggles (zebra/fabricd default on), Settings → FRR UI, array-start install, companion marker for Thunderbolt Net.
- Docs: detailed what-it-does guide, scope/safety (host-wide routing, not TB-only), LAN-safe defaults, Thunderbolt Net integration.
- Idle and safe when packages/ is empty. Does not require Thunderbolt Net. CA listing via ibigsnet/unraid-templates.
</CHANGES>

<!--
  UnraidFRR is intentionally separate from ThunderboltNet:
  package install is invasive; users opt in. No PHP requires across plugins.
  Removal must not leave broken Unraid UI (StorageGuard/ThunderboltNet discipline).
-->

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "UnraidFRR: preparing directories..."
rm -rf /usr/local/emhttp/plugins/UnraidFRR
rm -rf /usr/local/emhttp/plugins/unraidfrr
mkdir -p /usr/local/emhttp/plugins/UnraidFRR/include
mkdir -p /usr/local/emhttp/plugins/UnraidFRR/scripts
mkdir -p /usr/local/emhttp/plugins/UnraidFRR/event
mkdir -p /usr/local/emhttp/plugins/UnraidFRR/packages
mkdir -p /boot/config/plugins/UnraidFRR/packages
echo "UnraidFRR: directories ready."
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/UnraidFRR.page">
<URL>&raw;/UnraidFRR.page?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/default.cfg">
<URL>&raw;/default.cfg?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/README.md">
<INLINE>
<![CDATA[
**FRR (FRRouting)**

Optional FRRouting suite for Unraid — fully automated install (like the Nvidia Driver plugin): downloads and installs FRR packages matched to your Unraid product version + arch. Choose daemons under Settings → FRR. Standalone: Thunderbolt Net is not required. Does not edit eth0/br0 by default. Pair with Thunderbolt Net for TB multi-host OpenFabric.
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/packages/manifest.json">
<URL>&raw;/packages/manifest.json?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/include/frr-lib.php">
<URL>&raw;/include/frr-lib.php?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/include/frr-update.php">
<URL>&raw;/include/frr-update.php?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/scripts/frr-install-packages">
<URL>&raw;/scripts/frr-install-packages?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/scripts/frr-apply">
<URL>&raw;/scripts/frr-apply?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/scripts/frr-download">
<URL>&raw;/scripts/frr-download?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/UnraidFRR/event/started">
<URL>&raw;/event/started?v=&version;</URL>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "UnraidFRR: finishing install..."
chmod 755 /usr/local/emhttp/plugins/UnraidFRR/scripts/frr-install-packages 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/UnraidFRR/scripts/frr-apply 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/UnraidFRR/scripts/frr-download 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/UnraidFRR/event/started 2>/dev/null || true
mkdir -p /boot/config/plugins/UnraidFRR/packages
if [ ! -f /boot/config/plugins/UnraidFRR/UnraidFRR.cfg ]; then
  if [ -f /usr/local/emhttp/plugins/UnraidFRR/default.cfg ]; then
    cp -a /usr/local/emhttp/plugins/UnraidFRR/default.cfg /boot/config/plugins/UnraidFRR/UnraidFRR.cfg
    echo "UnraidFRR: created default UnraidFRR.cfg"
  fi
fi
# Automated apply: catalog download + install when a bundle exists (no-op if catalog empty)
php -r 'require_once "/usr/local/emhttp/plugins/UnraidFRR/include/frr-lib.php"; frr_write_companion_marker(); frr_apply();' 2>/dev/null || true
echo "UnraidFRR: install complete."
echo "UnraidFRR: Settings → FRR (FRRouting) → Apply (auto-download on by default)."
echo "UnraidFRR: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "UnraidFRR: removing plugin (full cleanup)..."

# 1) Stop FRR so package removal is not blocked and daemons do not linger
systemctl stop frr 2>/dev/null || true
/usr/lib/frr/frrinit.sh stop 2>/dev/null || true
service frr stop 2>/dev/null || true
for p in zebra fabricd bgpd ospfd ospf6d isisd staticd bfdd watchfrr; do
  pkill -x "$p" 2>/dev/null || true
done
sleep 1

# 2) removepkg packages we installed (from managed MANIFEST) — undoes live installpkg
MAN=/boot/config/plugins/UnraidFRR/packages/MANIFEST.txt
if [ -f "$MAN" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="$(echo "$line" | tr -d '\r' | xargs)"
    [ -z "$line" ] && continue
    base="$(basename "$line")"
    # Package name as Slackware/Unraid records it (strip .txz/.tgz)
    pkgname="$(echo "$base" | sed -E 's/\.(t[gx]z|tar\.gz)$//')"
    if command -v removepkg >/dev/null 2>&1; then
      echo "UnraidFRR: removepkg $pkgname"
      removepkg "$pkgname" 2>/dev/null || removepkg "$base" 2>/dev/null || true
    fi
  done < "$MAN"
else
  # Best-effort: common FRR package names if MANIFEST missing
  if command -v removepkg >/dev/null 2>&1; then
    for pkgname in frr libyang; do
      ls /var/log/packages/${pkgname}-* >/dev/null 2>&1 && removepkg "$pkgname" 2>/dev/null || true
    done
  fi
fi

# 3) Remove emhttp plugin tree (case variants — avoid leftover pages)
rm -rf /usr/local/emhttp/plugins/UnraidFRR
rm -rf /usr/local/emhttp/plugins/unraidfrr
rm -rf /usr/local/emhttp/plugins/Unraidfrr

# 4) Remove flash state (cfg, package cache, marker) — clean reinstall
rm -rf /boot/config/plugins/UnraidFRR
rm -rf /boot/config/plugins/unraidfrr

# 5) Temp install copies
rm -f /tmp/plugins/unraidfrr.plg /tmp/plugins/UnraidFRR* 2>/dev/null || true
rm -f /tmp/inline*-unraidfrr.sh 2>/dev/null || true

if [ -e /usr/local/emhttp/plugins/UnraidFRR ] || [ -e /usr/local/emhttp/plugins/unraidfrr ]; then
  echo "UnraidFRR: WARNING — emhttp plugin path still present"
else
  echo "UnraidFRR: emhttp plugin paths clear"
fi

echo "UnraidFRR: removed."
echo "UnraidFRR: did not modify network.cfg, br0, Docker, or Thunderbolt Net."
echo "UnraidFRR: hard-refresh the browser; reboot if any FRR process still shows in ps."
]]></INLINE>
</FILE>

</PLUGIN>
