}
.frr-wrap .frr-actions {
  margin: 1.1em 0 0;
  padding: 0.85em 0 0.2em;
  border-top: 1px dashed rgba(128, 128, 128, 0.4);
}
.frr-wrap .frr-daemon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65em 1.25em;
