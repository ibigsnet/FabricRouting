<?php
/**
 * Settings → Network Settings → Fabric Routing
 * CA: Fabric Routing (FRR). Plugin id: UnraidFRR.
 */
require_once '/usr/local/emhttp/plugins/UnraidFRR/include/frr-lib.php';

$plugin = 'UnraidFRR';
$cfg = function_exists('parse_plugin_cfg') ? parse_plugin_cfg($plugin) : [];
if (!is_array($cfg)) {
  $cfg = [];
}
$cfg = array_merge(frr_load_cfg(), $cfg);
$st = frr_status();
$det = $st['detect'];
$bundle = $st['bundle'] ?? [];
$ver = htmlspecialchars($st['plugin_version'] ?? 'dev');
$tbn = !empty($st['thunderboltnet_present']);
$uver = htmlspecialchars($det['unraid_version'] ?? frr_unraid_version());
$arch = htmlspecialchars($det['arch'] ?? frr_arch());

$zebra_run = !empty($det['running_zebra']);
$fabricd_run = !empty($det['running_fabricd']);
$frr_ok = !empty($det['vtysh']) || $zebra_run || $fabricd_run;
$pk = $det['packages_on_flash'] ?? [];
$bundle_ok = !empty($bundle['ok']);
?>
<style>
.frr-wrap { max-width: 54em; }
.frr-wrap .frr-lead {
  margin: 0 0 0.75em;
  font-size: 0.95em;
  line-height: 1.4;
  opacity: 0.9;
}
