<?php
/**
 * Fully automated FRR manager (Nvidia-plugin style). Never require ThunderboltNet.
 */
require_once '/usr/local/emhttp/plugins/UnraidFRR/include/frr-lib.php';

$plugin = 'UnraidFRR';
$cfg = function_exists('parse_plugin_cfg') ? parse_plugin_cfg($plugin) : [];
if (!is_array($cfg)) {
  $cfg = [];
}
$cfg = array_merge(frr_load_cfg(), $cfg);
$st = frr_status();
$det = $st['detect'];
$bundle = $st['bundle'] ?? [];
$ver = htmlspecialchars($st['plugin_version'] ?? 'dev');
$tbn = !empty($st['thunderboltnet_present']);
$uver = htmlspecialchars($det['unraid_version'] ?? frr_unraid_version());
$arch = htmlspecialchars($det['arch'] ?? frr_arch());
?>
<div class="frr-wrap" style="max-width:52em">
  <h3>FRR (FRRouting) for Unraid</h3>
  <p>
    Fully automated install and management of
    <a href="https://frrouting.org/" target="_blank" rel="noopener">FRRouting</a>
    (like the Nvidia Driver plugin: you choose options; the plugin downloads, verifies, and installs).
    <strong>Standalone</strong> — Thunderbolt Net is not required.
  </p>
  <p>
    <strong>Not Thunderbolt-only:</strong> FRR is a host-wide routing suite.
    Defaults do not put eth0/br0 into any protocol and do not edit Unraid Network Settings.
    <a href="https://github.com/ibigsnet/UnraidFRR/blob/main/docs/scope-and-safety.md" target="_blank" rel="noopener">Scope &amp; safety ↗</a>
    ·
    <a href="https://github.com/ibigsnet/UnraidFRR/blob/main/docs/automation-design.md" target="_blank" rel="noopener">Automation design ↗</a>
  </p>

  <table class="tablesorter shift" style="width:100%">
    <tr><td style="width:14em">Plugin version</td><td><code><?= $ver ?></code></td></tr>
    <tr><td>Unraid / arch</td><td><code><?= $uver ?></code> · <code><?= $arch ?></code></td></tr>
    <tr><td>Status</td><td><?= htmlspecialchars($det['note'] ?? '') ?></td></tr>
    <tr><td>Automated bundle</td>
      <td><?php
        if (!empty($bundle['ok'])) {
          echo 'FRR <code>' . htmlspecialchars($bundle['frr_version'] ?? '') . '</code> · channel <code>'
            . htmlspecialchars($bundle['channel'] ?? '') . '</code>';
        } else {
          echo '<em>' . htmlspecialchars($bundle['error'] ?? 'resolving…') . '</em>';
        }
      ?></td></tr>
    <tr><td>vtysh</td><td><code><?= htmlspecialchars($det['vtysh'] ?: '—') ?></code>
      <?= !empty($det['version']) ? ' · ' . htmlspecialchars($det['version']) : '' ?></td></tr>
    <tr><td>zebra / fabricd</td>
      <td><?= !empty($det['running_zebra']) ? 'zebra running' : 'zebra not running' ?>
        · <?= !empty($det['running_fabricd']) ? 'fabricd running' : 'fabricd not running' ?></td></tr>
    <tr><td>Package cache</td>
      <td><?php
        $pk = $det['packages_on_flash'] ?? [];
        echo $pk
          ? count($pk) . ' file(s) managed under flash cache'
          : '<em>empty — Apply will auto-download when a bundle exists</em>';
      ?></td></tr>
    <tr><td>Thunderbolt Net</td>
      <td><?= $tbn
        ? 'Installed — can use FRR for OpenFabric when enabled there'
        : 'Not installed (OK)' ?></td></tr>
  </table>

  <blockquote class="inline_help">
    <strong>Fully automated:</strong> you do not download or copy <code>.txz</code> files yourself.
    Apply (or array start) fetches the catalog, downloads the matching package set for this Unraid version,
    verifies checksums, runs <code>installpkg</code>, enables daemons, and starts FRR — same idea as the Nvidia Driver plugin.<br><br>
    Until a build is published for your Unraid version, status explains that clearly; the system stays safe.
    Docs:
    <a href="https://github.com/ibigsnet/UnraidFRR/blob/main/DOCS.md" target="_blank" rel="noopener">DOCS.md</a>
  </blockquote>

  <form method="POST" action="/update.php" target="progressFrame">
    <input type="hidden" name="#file" value="UnraidFRR/UnraidFRR.cfg">
    <input type="hidden" name="#include" value="/plugins/UnraidFRR/include/frr-update.php">

    <dl>
      <dt>Package channel:</dt>
      <dd>
        <select name="package_channel">
          <?= mk_option($cfg['package_channel'] ?? 'latest', 'latest', 'Latest stable (recommended)') ?>
          <?= mk_option($cfg['package_channel'] ?? 'latest', 'previous', 'Previous stable (rollback)') ?>
        </select>
      </dd>
    </dl>
    <blockquote class="inline_help">
      Which automated package set to download from the project catalog. Channels appear as builds are published.
    </blockquote>

    <dl>
      <dt>Auto-download packages:</dt>
      <dd>
        <select name="auto_download">
          <?= mk_option($cfg['auto_download'] ?? 'yes', 'yes', 'Yes (default — fully automatic)') ?>
          <?= mk_option($cfg['auto_download'] ?? 'yes', 'no', 'No — use flash cache only') ?>
        </select>
      </dd>
    </dl>
    <blockquote class="inline_help">
      <strong>Yes</strong> (product default): fetch catalog + packages when missing or outdated. No manual package steps.
    </blockquote>

    <dl>
      <dt>Install on array start:</dt>
      <dd>
        <select name="install_on_start">
          <?= mk_option($cfg['install_on_start'] ?? 'yes', 'yes', 'Yes') ?>
          <?= mk_option($cfg['install_on_start'] ?? 'yes', 'no', 'No') ?>
        </select>
      </dd>
    </dl>
    <blockquote class="inline_help">
      Reinstall FRR into the live (RAM) system after reboot — required because Unraid does not keep packages across boot.
    </blockquote>

    <dl>
      <dt>Catalog URL (advanced):</dt>
      <dd>
        <input type="text" name="package_base_url" style="width:32em"
          value="<?= htmlspecialchars($cfg['package_base_url'] ?? '') ?>"
          placeholder="default: GitHub packages/manifest.json">
      </dd>
    </dl>
    <blockquote class="inline_help">
      Leave empty for the official catalog. Only change if you host a mirror.
    </blockquote>

    <dl>
      <dt>Enable zebra:</dt>
      <dd>
        <select name="enable_zebra">
          <?= mk_option($cfg['enable_zebra'] ?? 'yes', 'yes', 'Yes (required for routing)') ?>
          <?= mk_option($cfg['enable_zebra'] ?? 'yes', 'no', 'No') ?>
        </select>
      </dd>
    </dl>
    <blockquote class="inline_help">zebra talks to the kernel RIB/FIB. Leave Yes for almost all uses.</blockquote>

    <dl>
      <dt>Enable fabricd (OpenFabric):</dt>
      <dd>
        <select name="enable_fabricd">
          <?= mk_option($cfg['enable_fabricd'] ?? 'yes', 'yes', 'Yes (default — TB mesh / fabric)') ?>
          <?= mk_option($cfg['enable_fabricd'] ?? 'yes', 'no', 'No') ?>
        </select>
      </dd>
    </dl>
    <blockquote class="inline_help">
      OpenFabric daemon used with Thunderbolt Net multi-host routing. Safe without TBN if you use fabricd elsewhere.
    </blockquote>

    <dl>
      <dt>Enable staticd:</dt>
      <dd>
        <select name="enable_staticd">
          <?= mk_option($cfg['enable_staticd'] ?? 'yes', 'yes', 'Yes') ?>
          <?= mk_option($cfg['enable_staticd'] ?? 'yes', 'no', 'No') ?>
        </select>
      </dd>
    </dl>

    <dl>
      <dt>Enable bgpd / ospfd / ospf6d / isisd / bfdd:</dt>
      <dd>
        bgpd
        <select name="enable_bgpd"><?= mk_option($cfg['enable_bgpd'] ?? 'no', 'no', 'No') ?><?= mk_option($cfg['enable_bgpd'] ?? 'no', 'yes', 'Yes') ?></select>
        ospfd
        <select name="enable_ospfd"><?= mk_option($cfg['enable_ospfd'] ?? 'no', 'no', 'No') ?><?= mk_option($cfg['enable_ospfd'] ?? 'no', 'yes', 'Yes') ?></select>
        ospf6d
        <select name="enable_ospf6d"><?= mk_option($cfg['enable_ospf6d'] ?? 'no', 'no', 'No') ?><?= mk_option($cfg['enable_ospf6d'] ?? 'no', 'yes', 'Yes') ?></select>
        isisd
        <select name="enable_isisd"><?= mk_option($cfg['enable_isisd'] ?? 'no', 'no', 'No') ?><?= mk_option($cfg['enable_isisd'] ?? 'no', 'yes', 'Yes') ?></select>
        bfdd
        <select name="enable_bfdd"><?= mk_option($cfg['enable_bfdd'] ?? 'no', 'no', 'No') ?><?= mk_option($cfg['enable_bfdd'] ?? 'no', 'yes', 'Yes') ?></select>
      </dd>
    </dl>
    <blockquote class="inline_help">Default No. Only enable what you use.</blockquote>

    <dl>
      <dt>Start/restart FRR on Apply:</dt>
      <dd>
        <select name="start_frr">
          <?= mk_option($cfg['start_frr'] ?? 'yes', 'yes', 'Yes') ?>
          <?= mk_option($cfg['start_frr'] ?? 'yes', 'no', 'No') ?>
        </select>
      </dd>
    </dl>

    <p>
      <input type="submit" name="#apply" value="Apply">
      <input type="button" value="Done" onclick="done()">
    </p>
  </form>
</div>
