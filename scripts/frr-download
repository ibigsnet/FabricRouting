#!/bin/bash
# Download the FRR package bundle for this Unraid host into the flash cache.
# Fully automated — users do not place files manually.
# Invoked by PHP (frr_download_bundle) or CLI.
set -euo pipefail

PLUGIN_PHP=/usr/local/emhttp/plugins/FabricRouting/include/frr-lib.php
if [ ! -f "$PLUGIN_PHP" ]; then
  PLUGIN_PHP="$(cd "$(dirname "$0")/.." && pwd)/include/frr-lib.php"
fi

php -r '
require_once "'"$PLUGIN_PHP"'";
$r = frr_download_bundle();
echo json_encode($r, JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES), "\n";
exit(!empty($r["ok"]) ? 0 : 1);
'
