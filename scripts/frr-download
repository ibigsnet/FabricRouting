#!/bin/bash
# CLI: download and verify the package set for this Unraid version into the flash cache.
# Does not install. Use frr-apply afterwards (or the page's Download & Install).
LIB="$(cd "$(dirname "$0")/.." && pwd)/include/frr-lib.php"
# shellcheck disable=SC2016 # PHP code, not shell
FABRICROUTING_NO_HTML=1 exec php -d display_errors=0 -r 'require $argv[1]; $r = frr_apply(["download" => true, "install" => false]); exit(!empty($r["ok"]) ? 0 : 1);' "$LIB"
