#!/bin/bash
# CLI Apply: install packages already on flash (sha256-verified), rebuild config, start FRR.
LIB="$(cd "$(dirname "$0")/.." && pwd)/include/frr-lib.php"
# shellcheck disable=SC2016 # PHP code, not shell
FABRICROUTING_NO_HTML=1 exec php -d display_errors=0 -r 'require $argv[1]; $r = frr_apply(["install" => true]); exit(!empty($r["ok"]) ? 0 : 1);' "$LIB"
