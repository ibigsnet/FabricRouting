#!/bin/bash
# Explicit package download/install job for Unraid openBox (logging.htm).
# Same UX pattern as nvidia-driver: streaming log + DONE button; do not close early.
#
# Invoked as:
#   openBox('/usr/local/emhttp/plugins/FabricRouting/scripts/frr-packages-job&arg1=MODE', ...)
# MODE: latest | previous | flash
set -u

MODE="${1:-latest}"
case "$MODE" in
  latest|previous|flash) ;;
  *) MODE=latest ;;
esac

PLUGIN_PHP=/usr/local/emhttp/plugins/FabricRouting/include/frr-lib.php
if [ ! -f "$PLUGIN_PHP" ]; then
  PLUGIN_PHP="$(cd "$(dirname "$0")/.." && pwd)/include/frr-lib.php"
fi

if [ ! -f "$PLUGIN_PHP" ]; then
  echo "ERROR: frr-lib.php not found"
  exit 1
fi

# Stream progress immediately (emhttpd / logging.htm)
export PHP_FCGI_CHILDREN=0
php -d display_errors=0 -d zlib.output_compression=0 -r '
require_once $argv[1];
@ini_set("zlib.output_compression", "0");
@ini_set("output_buffering", "0");
@ini_set("implicit_flush", "1");
while (ob_get_level() > 0) { @ob_end_flush(); }
ob_implicit_flush(true);
$r = frr_packages_job($argv[2]);
exit(!empty($r["ok"]) ? 0 : 1);
' "$PLUGIN_PHP" "$MODE"
exit $?
