#!/bin/bash
# Array start: install FRR packages already on flash (sha256-verified, no network),
# rebuild /etc/frr from flash (baseline + Thunderbolt Net fragment + frr.user.conf)
# and start FRR. Detached so emhttp's event chain is never blocked.
CFG=/boot/config/plugins/FabricRouting/FabricRouting.cfg
LIB=/usr/local/emhttp/plugins/FabricRouting/include/frr-lib.php
LOG=/var/log/fabricrouting.log

if [ ! -f "$LIB" ]; then
  logger -t FabricRouting "array start: frr-lib missing, skip"
  exit 0
fi
if [ -f "$CFG" ] && grep -q '^install_on_start="no"' "$CFG" 2>/dev/null; then
  logger -t FabricRouting "array start: install_on_start=no, skip"
  exit 0
fi

CMD="FABRICROUTING_NO_HTML=1 php -d display_errors=0 -r 'require \"$LIB\"; frr_rehydrate_local();' >>$LOG 2>&1"
if command -v at >/dev/null 2>&1 && echo "$CMD" | at now 2>/dev/null; then
  logger -t FabricRouting "array start: rehydrate scheduled (at)"
  exit 0
fi
nohup bash -c "$CMD" >/dev/null 2>&1 &
logger -t FabricRouting "array start: rehydrate scheduled (nohup)"
exit 0
